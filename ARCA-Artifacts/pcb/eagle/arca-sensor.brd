<contactref element="R1" pad="1"/>
<wire x1="14.27" y1="19" x2="14.27" y2="16.5" width="0.6" layer="16"/>
</signal>
<signal name="ECHO">
<contactref element="R1" pad="2"/>
<contactref element="R2" pad="1"/>
<contactref element="J1" pad="2"/>
<wire x1="14.27" y1="13.96" x2="14.27" y2="11.42" width="0.6" layer="16"/>
<wire x1="14.27" y1="13.96" x2="11.73" y2="11.42" width="0.6" layer="16"/>
<wire x1="11.73" y1="11.42" x2="11.73" y2="4" width="0.6" layer="16"/>
</signal>
<signal name="GND" class="1">
<contactref element="J2" pad="4"/>
<contactref element="R2" pad="2"/>
<contactref element="J1" pad="3"/>
<wire x1="16.81" y1="19" x2="16.81" y2="8.88" width="0.8" layer="16"/>
<wire x1="16.81" y1="8.88" x2="14.27" y2="8.88" width="0.8" layer="16"/>
