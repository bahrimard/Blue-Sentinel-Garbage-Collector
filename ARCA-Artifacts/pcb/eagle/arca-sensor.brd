<param name="rlMinPadBottom" value="0.3mm"/>
<param name="mvStopFrame" value="1"/>
<param name="mlMinStopFrame" value="0.1mm"/>
<param name="mlMaxStopFrame" value="0.1mm"/>
</designrules>
<autorouter/>
<elements>
<element name="J2" library="arca" package="HDR1X4_H" value="HC-SR04" x="13" y="19"/>
