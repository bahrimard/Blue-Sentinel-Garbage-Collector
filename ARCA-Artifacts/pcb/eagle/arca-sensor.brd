<contactref element="J2" pad="1"/>
<contactref element="J1" pad="4"/>
<wire x1="9.19" y1="19" x2="9.19" y2="21.3" width="0.8" layer="16"/>
<wire x1="9.19" y1="21.3" x2="23" y2="21.3" width="0.8" layer="16"/>
